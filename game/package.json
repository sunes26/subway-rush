{
  "name": "subway-rush",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "지하철 러쉬 (SUBWAY RUSH) — P0 playable skeleton",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "tour": "playwright test tests/e2e/tour.spec.ts",
    "dump:collision": "tsx tools/dump-collision.ts",
    "verify": "npm run typecheck && npm run test && npm run build",
    "sweep": "tsx tools/sweep.ts",
    "assets": "node tools/copy-assets.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/three": "^0.180.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
